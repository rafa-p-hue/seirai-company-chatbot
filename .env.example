# Shared / root example. Prefer service-specific files:
# - frontend/.env.local
# - backend/.env

# Frontend → FastAPI
NEXT_PUBLIC_RAG_API_URL=http://localhost:8000

# Backend core
APP_ENV=development
APP_NAME=seirai-rag-backend
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_PREFIX=/api
REQUEST_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=10485760

# Company / crawl safety
DEFAULT_COMPANY_ID=seirai
ALLOWED_CRAWL_DOMAINS=
MAX_CRAWL_PAGES=20

# Qdrant
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_chunks
QDRANT_API_KEY=

# Embeddings (local sentence-transformers by default)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# LLM / Qwen-compatible (Ollama OpenAI-compatible API)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
ENABLE_RERANKER=true

# Local fallbacks when Docker/Ollama are unavailable:
# VECTOR_STORE=memory
# EMBEDDING_PROVIDER=hash
# LLM_PROVIDER=deterministic
