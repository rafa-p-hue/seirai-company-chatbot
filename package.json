{
  "name": "seirai-company-chatbot",
  "private": true,
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:typecheck": "npm --prefix frontend exec -- tsc --noEmit",
    "frontend:test": "npm --prefix frontend test",
    "qdrant:up": "docker compose up -d qdrant",
    "qdrant:down": "docker compose down",
    "backend:test": "bash scripts/dev.sh backend:test",
    "backend:dev": "bash scripts/dev.sh backend:dev"
  }
}
